#!/usr/bin/env bash
# L99 Screen AppImage launcher.
#   ./L99_Screen.AppImage               -> GUI
#   ./L99_Screen.AppImage image pic.jpg -> command line (image|gif|detect|gui|udev-rule)
HERE="$(dirname "$(readlink -f "$0")")"
PY="$HERE/opt/python@PYVER@/bin/python@PYVER@"

export TCL_LIBRARY="$HERE/@TCLDIR@"
export TK_LIBRARY="$HERE/@TKDIR@"
export TKPATH="$TK_LIBRARY"
export PYTHONNOUSERSITE=1
unset PYTHONHOME PYTHONPATH

case "${1:-}" in
  --selftest)
    exec "$PY" -c "import tkinterdnd2, l99screen.gui; r = tkinterdnd2.TkinterDnD.Tk(); l99screen.gui.App(r); r.update(); r.destroy(); print('GUI + drag-and-drop OK')" ;;
  image|gif|detect|gui|udev-rule|-h|--help) exec "$PY" -m l99screen "$@" ;;
  *) exec "$PY" -m l99screen gui "$@" ;;
esac
