#!/usr/bin/env bash
# L99 Screen AppImage launcher.
#   ./L99_Screen.AppImage               -> GUI
#   ./L99_Screen.AppImage image pic.jpg -> command line (image|gif|detect|gui|udev-rule)
HERE="$(dirname "$(readlink -f "$0")")"
PY="$HERE/opt/python@PYVER@/bin/python@PYVER@"

tcl="$(ls -d "$HERE"/usr/share/tcltk/tcl8* "$HERE"/usr/share/tcltk/tcl9* 2>/dev/null | head -1)"
tk="$(ls -d "$HERE"/usr/share/tcltk/tk8* "$HERE"/usr/share/tcltk/tk9* 2>/dev/null | head -1)"
[ -n "$tcl" ] && export TCL_LIBRARY="$tcl"
[ -n "$tk" ] && export TK_LIBRARY="$tk" && export TKPATH="$tk"
export PYTHONNOUSERSITE=1
unset PYTHONHOME PYTHONPATH

case "${1:-}" in
  image|gif|detect|gui|udev-rule|-h|--help) exec "$PY" -m l99screen "$@" ;;
  *) exec "$PY" -m l99screen gui "$@" ;;
esac
